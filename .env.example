# ═══ NexusAI Environment Variables ═══
# Copy this file to .env.local for local development
# In Vercel: add these in Settings → Environment Variables

# Required: HuggingFace Inference API token
# Get yours free at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Optional: Tavily API key for web search
# Free tier: 1000 searches/month at https://tavily.com
# If not set, web search falls back to Wikipedia (free, no key needed)
TAVILY_API_KEY=tvly-your_key_here
